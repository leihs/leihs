set -euo pipefail

ENV_DIR="$(cd -- "$(dirname "${BASH_SOURCE}")"; cd . > /dev/null 2>&1 && pwd -P)"

# Check if mise is in PATH and set TOOL_VERSIONS_MANAGER accordingly
if type "mise" &> /dev/null && [ -z "${TOOL_VERSIONS_MANAGER:-}" ]; then
    export TOOL_VERSIONS_MANAGER="mise"
fi

# resort to asdf if TOOL_VERSIONS_MANAGER is not set
if [ -z "${TOOL_VERSIONS_MANAGER:-}" ]; then
    export TOOL_VERSIONS_MANAGER="asdf"
fi

case "$TOOL_VERSIONS_MANAGER" in
  asdf|asdf-vm)
    source "$ENV_DIR/asdf-helper.bash"
    asdf-load
    echo "Using asdf $(asdf --version) as TOOL_VERSIONS_MANAGER"
    ;;
  mise)
    if type "mise" &> /dev/null; then
      echo "Using mise $(mise --version) as TOOL_VERSIONS_MANAGER"
      # put the mise shims first in PATH: a shim resolves the tool version
      # pinned for the current directory when it is called, whereas
      # `mise activate` puts the versions of the directory where it ran (or
      # the global ones) first, and tools installed later are not in PATH
      MISE_SHIMS_DIR="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims"
      if [[ ":$PATH:" != ":$MISE_SHIMS_DIR:"* ]]; then
        export PATH="$MISE_SHIMS_DIR:$PATH"
      fi
    else
      echo "ERROR: mise is not installed but TOOL_VERSIONS_MANAGER is set to 'mise'"
      exit 1
    fi
    ;;
  *)
    echo "ERROR: Unsupported TOOL_VERSIONS_MANAGER: $TOOL_VERSIONS_MANAGER"
    exit 1
    ;;
esac
